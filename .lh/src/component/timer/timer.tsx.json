            "content": "import './timer.css';\r\nimport moment from \"moment\";\r\nimport { useEffect, useState } from \"react\";\r\n\r\nexport const RunningTimer = ({ startTime }) => {\r\n  const [now, setNow] = useState(moment());\r\n\r\n  useEffect(() => {\r\n    const interval = setInterval(() => {\r\n      setNow(moment());\r\n    }, 1000);\r\n\r\n    return () => clearInterval(interval);\r\n  }, []);\r\n\r\n  const duration = moment.duration(now.diff(startTime));\r\n  const formatted = moment.utc(duration.asMilliseconds()).format('HH:mm:ss');\r\n\r\n  return (\r\n    <div>\r\n      {/* Example timer display */}\r\n      {/* <p className=\"time\">{formatted}</p> */}\r\n\r\n      {/* Voltage Button */}\r\n      <div >\r\n        <button className=\"voltage-button\">{formatted}</button>\r\n\r\n        {/* SVG Party */}\r\n        <svg\r\n          version=\"1.1\"\r\n          xmlns=\"http://www.w3.org/2000/svg\"\r\n          viewBox=\"0 0 234.6 61.3\"\r\n          preserveAspectRatio=\"none\"\r\n        >\r\n          <filter id=\"glow\">\r\n            <feGaussianBlur className=\"blur\" result=\"coloredBlur\" stdDeviation=\"2\" />\r\n            <feTurbulence\r\n              type=\"fractalNoise\"\r\n              baseFrequency=\"0.075\"\r\n              numOctaves=\"0.3\"\r\n              result=\"turbulence\"\r\n            />\r\n            <feDisplacementMap\r\n              in=\"SourceGraphic\"\r\n              in2=\"turbulence\"\r\n              scale=\"30\"\r\n              xChannelSelector=\"R\"\r\n              yChannelSelector=\"G\"\r\n              result=\"displace\"\r\n            />\r\n            <feMerge>\r\n              <feMergeNode in=\"coloredBlur\" />\r\n              <feMergeNode in=\"coloredBlur\" />\r\n              <feMergeNode in=\"coloredBlur\" />\r\n              <feMergeNode in=\"displace\" />\r\n              <feMergeNode in=\"SourceGraphic\" />\r\n            </feMerge>\r\n          </filter>\r\n\r\n          <path\r\n            c